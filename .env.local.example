# ============================================================================
# CAMMES — Variáveis de ambiente (local)
# ============================================================================
# Copie este arquivo para `.env.local` e preencha com valores reais.
# `.env.local` NÃO deve ser commitado (já está no .gitignore).
#
# Em produção, configure estas variáveis no painel do Vercel (Settings → Environment Variables).
# ============================================================================

# --- Supabase ---
# URL do projeto Supabase (formato: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key pública — segura para expor ao cliente (respeita RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NUNCA expor ao cliente; ignorar RLS.
# Usar APENAS em Server Actions, Edge Functions ou scripts de admin.
SUPABASE_SERVICE_ROLE_KEY=
